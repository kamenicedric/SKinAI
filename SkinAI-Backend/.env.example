# ============================================================
# SKIN AI — Variables d'environnement
# Copie ce fichier en .env et remplis tes valeurs
# NE JAMAIS COMMITER le fichier .env sur GitHub !
# ============================================================

# ── Serveur ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Clé API Anthropic (SECRÈTE — jamais exposée côté client) ─
ANTHROPIC_API_KEY=sk-ant-api03-REMPLACE_PAR_TA_CLE_ANTHROPIC

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://PROJET.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Sécurité ─────────────────────────────────────────────────
# Clé secrète pour signer les tokens JWT (génère une clé aléatoire forte)
JWT_SECRET=REMPLACE_PAR_UNE_LONGUE_CLE_ALEATOIRE_32_CHARS

# ── Rate Limiting ─────────────────────────────────────────────
# Nombre max d'analyses par IP par heure
RATE_LIMIT_ANALYZE=10
# Nombre max de requêtes générales par IP par 15 minutes
RATE_LIMIT_GENERAL=100

# ── CORS ─────────────────────────────────────────────────────
# Origines autorisées (séparées par des virgules)
# En dev, laisse * ; en prod, mets l'URL de ton app
ALLOWED_ORIGINS=*
