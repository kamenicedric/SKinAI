{
  "expo": {
    "name": "SKIN AI",
    "slug": "skinai",
    "scheme": "skinai",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/android-chrome-512x512.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/android-chrome-512x512.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0A0B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.skinai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SKIN AI a besoin de votre caméra pour photographier votre visage et réaliser l'analyse cutanée.",
        "NSPhotoLibraryUsageDescription": "SKIN AI a besoin d'accéder à vos photos pour analyser votre peau."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-chrome-512x512.png",
        "backgroundColor": "#0D0A0B"
      },
      "package": "com.skinai.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon-48x48.png"
    },
    "updates": {
      "url": "https://u.expo.dev/1232d08a-f66d-4bfd-a2d1-601913ab528d",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "SKIN AI accède à vos photos pour analyser votre peau.",
          "cameraPermission": "SKIN AI utilise la caméra pour photographier votre visage."
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "1232d08a-f66d-4bfd-a2d1-601913ab528d"
      }
    },
    "owner": "timova"
  }
}
